# ════════════════════════════════════════════════════════════
# Configuration OTP & EMAIL — Coiffe Chez Toi
# ════════════════════════════════════════════════════════════

# Mode application
APP_ENV=development                     # production | development | testing

# ────────────────────────────────────────────────────────────
# EMAIL — Serveur SMTP
# ────────────────────────────────────────────────────────────

# Driver: mail | smtp | sendmail
MAIL_DRIVER=mail

# Adresse FROM (expéditeur)
MAIL_FROM_ADDRESS=noreply@coiffeschez-toi.local
MAIL_FROM_NAME=Coiffe Chez Toi

# Configuration SMTP (si MAIL_DRIVER=smtp)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_ENCRYPTION=none                    # none | tls | ssl
SMTP_USERNAME=                          # Laisser vide si non requis
SMTP_PASSWORD=                          # Laisser vide si non requis

# ────────────────────────────────────────────────────────────
# PARAMÈTRES OTP (facultatif — utilise les valeurs par défaut)
# ────────────────────────────────────────────────────────────

# Durée de validité (en secondes)
OTP_VALIDITY=300                        # 5 minutes

# Max tentatives avant invalidation
OTP_MAX_ATTEMPTS=5

# Délai minimum entre demandes (en secondes)
OTP_RATE_LIMIT_SECONDS=60               # 1 minute

# Max demandes par heure
OTP_MAX_REQUESTS_PER_HOUR=3

# ────────────────────────────────────────────────────────────
# FONCTIONNALITÉS OTP (activé/désactivé)
# ────────────────────────────────────────────────────────────

# Vérification email après inscription
OTP_REGISTRATION_ENABLED=true

# Réinitialisation du mot de passe
OTP_PASSWORD_RESET_ENABLED=true

# Changement d'email
OTP_EMAIL_CHANGE_ENABLED=true

# Suppression de compte (hautement recommandé)
OTP_ACCOUNT_DELETION_ENABLED=true

# Actions Domizi
OTP_DOMIZI_ACTION_ENABLED=true

# ────────────────────────────────────────────────────────────
# NOTES DE CONFIGURATION
# ────────────────────────────────────────────────────────────

# MAIL DRIVER = mail (par défaut)
#   Utilise la fonction PHP mail()
#   Configuré sur le serveur via php.ini (sendmail_path)
#   Pas de config supplémentaire à Kiro

# MAIL_DRIVER = smtp
#   Utilise PHPMailer avec connexion SMTP
#   Utile pour Gmail, SendGrid, ou serveur SMTP personnalisé
#   Exemple Gmail:
#     SMTP_HOST=smtp.gmail.com
#     SMTP_PORT=587
#     SMTP_ENCRYPTION=tls
#     SMTP_USERNAME=votre-email@gmail.com
#     SMTP_PASSWORD=app-password (pas le mot de passe Gmail)

# MAIL_DRIVER = sendmail
#   Utilise /usr/sbin/sendmail (déjà configuré)
#   Utile sur Linux

# Test de configuration
#   Utiliser: php security/test_email.php
