# DOMIZI - Redirection Apache
# Redirige toutes les requêtes vers public/index.php

Options -Indexes
RewriteEngine On

# Base du projet (sous-dossier XAMPP)
RewriteBase /coiffons/

# Si la requête est pour un fichier réel (CSS, JS, images) → servir directement
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Tout le reste → public/index.php
RewriteRule ^(.*)$ public/index.php [QSA,L]
