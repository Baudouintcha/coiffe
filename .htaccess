# DOMIZI - Redirection Apache
# Redirige toutes les requêtes vers public/index.php
# sauf les fichiers et dossiers qui existent réellement (CSS, JS, images...)

RewriteEngine On

# Si la requête est pour un fichier ou dossier qui existe → le servir directement
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Sinon → tout passer à public/index.php
RewriteRule ^(.*)$ public/index.php [QSA,L]
